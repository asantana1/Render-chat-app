# Example values - replace with your actual credentials
AUTH_USERNAME=your_auth_username
AUTH_PASSWORD=your_auth_password

SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_KEY=your_supabase_service_key
SECRET_KEY=your_supabase_secret_key

OPENAI_API_KEY=your_openai_apy_key

# SMTP Configuration for Business Email
SMTP_HOST=your_smtp_host
SMTP_PORT=your_smtp_port 
SMTP_USER=your_smtp_user #Usually your domain email
SMTP_PASS=your_smtp_password

# Where you want to receive contact form submissions
ADMIN_EMAIL=your_admin_email

# Server Configuration
PORT=your_port

# Common SMTP Settings by Provider:
# ===================================
# cPanel/WHM (most common):
#   SMTP_HOST=mail.your_domain_name.xyz
#   SMTP_PORT=587 (or 465 for SSL)
#
# GoDaddy:
#   SMTP_HOST=smtpout.secureserver.net
#   SMTP_PORT=587
#
# Bluehost:
#   SMTP_HOST=mail.your_domain_name.xyz
#   SMTP_PORT=587
#
# Namecheap:
#   SMTP_HOST=mail.privateemail.com
#   SMTP_PORT=587